<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.jiangbyte</groupId>
    <artifactId>voxel-ddd-lite-strcut</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>voxel-ddd-lite-strcut</name>
    <description>DDD 七层纯骨架：types/api/domain/infrastructure/case/trigger/app；中间件依赖默认注释</description>

    <modules>
        <module>voxel-ddd-lite-types</module>
        <module>voxel-ddd-lite-api</module>
        <module>voxel-ddd-lite-domain</module>
        <module>voxel-ddd-lite-infrastructure</module>
        <module>voxel-ddd-lite-case</module>
        <module>voxel-ddd-lite-trigger</module>
        <module>voxel-ddd-lite-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <aws.sdk.version>2.31.78</aws.sdk.version>
        <milvus.version>2.5.12</milvus.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <knife4j.version>5.7.4</knife4j.version>
        <jjwt.version>0.12.6</jjwt.version>
        <lombok.version>1.18.38</lombok.version>
        <hutool.version>5.8.38</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-case</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-trigger</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jiangbyte</groupId>
                <artifactId>voxel-ddd-lite-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 以下中间件默认注释：启用时取消注释并补齐实现类 -->
            <!--
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
